# Supabase project (Settings -> API). The anon key is safe for the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Public site URL, used for password-reset links (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OPTIONAL, server-only. Enables a durable market-data fallback in Supabase so
# last-known prices survive cold starts when the NEPSE API is down.
# Never prefix with NEXT_PUBLIC_. Never commit.
SUPABASE_SERVICE_ROLE_KEY=

# Market data: YONEPSE static JSON on GitHub Pages (https://shubhamnpk.github.io/yonepse/).
# Only change this to point at a mirror or a self-hosted copy of the same data folder.
YONEPSE_BASE_URL=https://shubhamnpk.github.io/yonepse/data
